# Copy this file to a local, untracked environment file.
# Never commit real credentials or secret values.

# Required for production mode. Use a long, random value.
IT_TEAM_API_KEY=replace-with-a-local-secret

# Allowed values: demo or production.
# demo is intended for local development only.
IT_TEAM_MODE=demo

# Optional: defaults to api/it_team.db when unset.
# IT_TEAM_DB_PATH=/absolute/path/to/it_team.db

# Optional: comma-separated browser origins. Leave empty unless a trusted
# frontend needs cross-origin access.
# IT_TEAM_CORS_ORIGINS=https://your-trusted-frontend.example

# Optional: Python logging level.
# IT_TEAM_LOG_LEVEL=INFO
