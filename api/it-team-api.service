[Unit]
Description=IT Team Framework API
After=network.target

[Service]
Type=simple
User=%i
WorkingDirectory=%h/it-team-framework/api
Environment=IT_TEAM_MODE=production
# Provide IT_TEAM_API_KEY and optionally IT_TEAM_DB_PATH through an EnvironmentFile
# stored outside the repository, for example: %h/.config/it-team-framework/api.env
# EnvironmentFile=%h/.config/it-team-framework/api.env
ExecStart=/usr/bin/python3 -m uvicorn server:app --host 127.0.0.1 --port 8080
Restart=on-failure

[Install]
WantedBy=multi-user.target
